# Copy this file to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored. Never put real secrets in this file.

# ---- AWS ----
AWS_REGION=us-east-2

# ---- Source database (Postgres in Docker, Phase 1) ----
POSTGRES_USER=trailhead
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trailhead_app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
